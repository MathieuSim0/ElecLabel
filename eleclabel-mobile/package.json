{
  "name": "eleclabel-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ElecLabel — application mobile Android (Capacitor + React) pour analyser un tableau électrique et générer des étiquettes PDF",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "android": "npm run build && cap sync android && cap open android",
    "android:prepare": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^6.0.1",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@react-pdf/renderer": "^3.4.4",
    "@supabase/supabase-js": "^2.45.4",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.0",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
