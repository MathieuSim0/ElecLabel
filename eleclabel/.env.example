# ElecLabel Desktop — modèle de configuration.
# Copie ce fichier en .env et remplis les valeurs. Le .env n'est jamais committé.

# Supabase — auth + synchronisation cloud (obligatoire)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Mode des clés IA ──
# Option A (recommandé, sécurisé) : proxy serveur — voir docs/AI-PROXY.md
#   Les clés OpenAI/Groq vivent sur la Supabase Edge Function, pas dans l'app.
VITE_USE_AI_PROXY=false

# Option B (simple, dev) : clés directes dans l'app (laisse VITE_USE_AI_PROXY=false)
#   ⚠️ À éviter pour un binaire distribué publiquement (clés extractibles).
VITE_OPENAI_API_KEY=sk-...
VITE_GROQ_API_KEY=gsk_...
